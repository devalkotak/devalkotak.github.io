    {
      "id": "90c989e6-ba33-44d5-914c-44d59f8f05aa",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Free. Always. Charging money filters out the kids who need it most, so we didn't. 4\u20136 hours, online (offline if a mentor happened to be nearby), scheduled entirely around the student and mentor's own time. No script, no forced curriculum \u2014 just a mentor who'd let you talk without judging you for it."
        }
      ],
      "type": "paragraph"
