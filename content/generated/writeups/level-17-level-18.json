{
  "blocks": [
    {
      "id": "1d806580-4618-4bdb-a7d9-da782b24df2b",
      "isToggleable": false,
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Level Goal"
        }
      ],
      "type": "heading_2"
    },
    {
      "id": "66ceb36e-058c-4ac3-836f-0e771687215a",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "There are two files in the home directory, "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "passwords.old"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " and "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "passwords.new"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": ". The password for the next level is in there somewhere, and the password has "
        },
        {
          "bold": true,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "changed exactly once between the files"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "."
        }
      ],
      "type": "paragraph"
    },
    {
      "id": "cf0a3064-bb4a-4532-8e6d-01d477bf88d7",
      "isToggleable": false,
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Solution"
        }
      ],
      "type": "heading_2"
    },
    {
      "id": "cd94a0ff-ccc6-4437-b634-071b0ef99f87",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Log in using "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "ssh -p 2220 bandit17@bandit.labs.overthewire.org"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " and the password obtained in the last level. Both files are large lists of candidate strings, one per line, so eyeballing them for the one line that differs isn't practical. We use "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "diff"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " to compare the two files line by line \u2014 it prints only the lines that changed, prefixed with "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "<"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " for the old version and "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": ">"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " for the new one. Since exactly one line changed, the "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": ">"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " line from "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "diff"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "'s output is the new password."
        }
      ],
      "type": "paragraph"
    },
