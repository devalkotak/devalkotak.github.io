{
  "blocks": [
    {
      "id": "4c7b90cc-b98b-44b8-bfa5-84b6eec4217f",
      "isToggleable": false,
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Level Goal"
        }
      ],
      "type": "heading_2"
    },
    {
      "id": "f083a4d0-7040-48fa-9079-2d43498e34dc",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "There's a setuid binary "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "suconnect"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " in the home directory. It connects to "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "localhost"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " on whatever port we pass it as an argument, reads a line of text from that connection, and compares it to the password of the next level ("
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "bandit21"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "), which it already knows internally. If what we send matches, it sends back the password for "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "bandit21"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "."
        }
      ],
      "type": "paragraph"
    },
    {
      "id": "291c7bb9-0ead-4412-afff-28c800649223",
      "isToggleable": false,
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Solution"
        }
      ],
      "type": "heading_2"
    },
    {
      "id": "46a63c3b-1d68-41b4-90d8-aa7486f9228f",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Log in using "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "ssh -p 2220 bandit20@bandit.labs.overthewire.org"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " and the password obtained in the last level. "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "suconnect"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " is the client here, not the server, so it needs something listening on the port we give it before it has anything to connect to. We open a second terminal session (a second SSH connection to "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "bandit20"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": ") and start "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "nc -l"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " listening on an arbitrary local port, feeding it the current level's password as the data it'll send once something connects. Back in the first terminal, we run "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "./suconnect <port>"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " against that same port. "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "suconnect"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " connects to our listener, reads the password we fed it, and since it matches what "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "suconnect"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " expected, it prints the password for "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "bandit21"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " straight to our first terminal."
        }
      ],
      "type": "paragraph"
    },
