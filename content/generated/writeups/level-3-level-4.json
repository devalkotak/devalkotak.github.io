    {
      "id": "6865c942-cd38-4c16-b5c7-60f35ec65ff1",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "The password for the next level is stored in a hidden file in the "
        },
        {
          "bold": true,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "inhere"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " directory."
        }
      ],
      "type": "paragraph"
    },
    {
      "id": "c93d2948-8c1b-468f-8526-e0ce8c5c06f7",
      "isToggleable": false,
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Solution"
        }
      ],
      "type": "heading_2"
    },
    {
      "id": "9f7d0145-bbb6-48cc-8b0a-e132a02bfb6a",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Log in using "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "ssh -p 2220 bandit3@bandit.labs.overthewire.org"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " and the password obtained in the last level. We navigate into the "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "inhere"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " directory. Running "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "ls"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " shows nothing, since hidden files (dotfiles) don't appear by default. We use "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "ls -la"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " to list all files including hidden ones, and find a file named "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "...Hiding-From-You"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": ", which gives us the password for the next level when we "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "cat"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " it."
        }
      ],
      "type": "paragraph"
    },
