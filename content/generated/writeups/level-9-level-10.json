      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "The password for the next level is stored in the file "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "data.txt"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " in one of the few human-readable strings, preceded by several "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "="
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " characters."
        }
      ],
      "type": "paragraph"
    },
    {
      "id": "40831939-9e4e-46b3-b896-a7360e961590",
      "isToggleable": false,
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Solution"
        }
      ],
      "type": "heading_2"
    },
    {
      "id": "fd87d89e-c77e-47db-b834-01f63b780883",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Log in using "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "ssh -p 2220 bandit9@bandit.labs.overthewire.org"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " and the password obtained in the last level. "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "data.txt"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " here is mostly binary data, so a plain "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "cat"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " is unreadable. We use "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "strings"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " to pull out only the human-readable sequences in the file, then pipe that through "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "grep"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " for "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "=="
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": ", since the password line is preceded by several "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "="
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " characters and that pattern is rare enough to isolate it from the other readable strings in the file."
        }
      ],
      "type": "paragraph"
    },
