      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "The password for the next level is stored in the file "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "data.txt"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " next to the word "
        },
        {
          "bold": true,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "millionth"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "."
        }
      ],
      "type": "paragraph"
    },
    {
