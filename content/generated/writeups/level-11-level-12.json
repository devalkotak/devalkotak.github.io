{
  "blocks": [
    {
      "id": "d55a290b-11d6-4839-bd74-764592834f9c",
      "isToggleable": false,
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Level Goal"
        }
      ],
      "type": "heading_2"
    },
    {
      "id": "b98ac128-5f0f-4a96-86e4-06c7a79a3999",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "The password for the next level is stored in the file "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "data.txt"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": ", where all lowercase (a-z) and uppercase (A-Z) letters have been "
        },
        {
          "bold": true,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "rotated by 13 positions"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " (ROT13)."
        }
      ],
      "type": "paragraph"
    },
    {
      "id": "c3cebd39-3c16-4835-b291-0ceb1dff0af3",
      "isToggleable": false,
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Solution"
        }
      ],
      "type": "heading_2"
    },
    {
      "id": "b806bc80-a7b2-45aa-ade9-ca67a4eada96",
      "richText": [
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "Log in using "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "ssh -p 2220 bandit11@bandit.labs.overthewire.org"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " and the password obtained in the last level. "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "cat"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": "-ing "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "data.txt"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " shows readable text, but it's scrambled \u2014 every letter has been shifted 13 places through the alphabet, wrapping from "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "z"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " back to "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "a"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": ". Since ROT13 is its own inverse (applying it twice returns the original text), we run the same rotation again to undo it. We use "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "tr"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " to remap each letter: the first range "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "A-Za-z"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " is the set of characters to translate, the second range "
        },
        {
          "bold": false,
          "code": true,
          "href": null,
          "italic": false,
          "plainText": "N-ZA-Mn-za-m"
        },
        {
          "bold": false,
          "code": false,
          "href": null,
          "italic": false,
          "plainText": " is what each of those characters becomes, shifted 13 positions."
        }
      ],
      "type": "paragraph"
    },
